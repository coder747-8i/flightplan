# Copy to .env and fill in. Never commit .env.
# Windy Map Forecast API key (api.windy.com/keys), domain-locked to where you open the app
WINDY_MAP_KEY=
# Windy Point Forecast API key (winds aloft for the navlog); falls back to Open-Meteo when empty
WINDY_POINT_KEY=
# FAA NOTAM API (api.faa.gov) client id / secret
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=
