#!/usr/bin/env bash
# Update Flightplan from a newer package (deploy/build-package.sh makes it; copy it here with
# scp) and apply Debian updates, keeping all data, passwords and settings. Run as root:
#   flightplan-update /root/flightplan-server-linux-x86_64.tar.gz
# Without a package it only applies Debian updates.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8
[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
pkg="${1:-${TARBALL:-}}"

echo "== Debian updates"
apt-get -qq update && apt-get -y -qq upgrade >/dev/null && apt-get -y -qq autoremove --purge >/dev/null
rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

if [ -z "$pkg" ]; then
  echo "no package given: Flightplan itself unchanged ($(cat /opt/flightplan/VERSION 2>/dev/null || echo '?'))"
  exit 0
fi
[ -f "$pkg" ] || { echo "$pkg doesn't exist" >&2; exit 1; }
echo "== Flightplan"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
tar -C "$tmp" -xzf "$pkg" flightplan/deploy/install.sh
# the new package's installer: it replaces the program and keeps the data
TARBALL="$pkg" PORT="$(systemctl show flightplan.service -p Environment --value | tr ' ' '\n' | sed -n 's/^PORT=//p')" \
  TUNNEL_IP="$(systemctl show flightplan.service -p Environment --value | tr ' ' '\n' | sed -n 's/^FP_TRUSTED_PROXIES=//p')" \
  bash "$tmp/flightplan/deploy/install.sh"
